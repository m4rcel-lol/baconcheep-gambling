# Discord Bot Configuration
# Get these values from https://discord.com/developers/applications

# Bot Token (from Bot section)
TOKEN=your_bot_token_here

# Application ID (from General Information)
CLIENT_ID=your_client_id_here

# Server/Guild ID (enable Developer Mode in Discord, right-click server, Copy ID)
GUILD_ID=your_guild_id_here

# Admin Role ID (right-click role, Copy ID)
ADMIN_ROLE_ID=your_admin_role_id_here

# Withdraw Role ID (currently not used in the bot)
WITHDRAW_ROLE_ID=your_withdraw_role_id_here

# Deposit Category ID (category where deposit channels will be created)
DEPOSIT_CATEGORY_ID=your_deposit_category_id_here

# Coinflip Channel ID (channel where coinflip games will be posted)
COINFLIP_CHANNEL_ID=your_coinflip_channel_id_here
